// Prisma schema for HairBook (hair salon appointment app)
// DB: PostgreSQL (Neon/Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  NO_SHOW
  COMPLETED
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELED
}


model User {
  id           String   @id @default(cuid())
  salonId      String?
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon Salon? @relation(fields: [salonId], references: [id])

  @@index([salonId])
}


model Salon {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  timezone  String   @default("Europe/Madrid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     Service[]
  staff        Staff[]
  customers    Customer[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  webhookKeys  WebhookClient[]
  users       User[]
  messageLogs MessageLog[]
  payments    Payment[]
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  name        String
  durationMin Int
  priceCents  Int      @default(0)
  bufferMin   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  waitlistEntries WaitlistEntry[]


  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([salonId])  
  @@unique([salonId, name], name: "salonId_name")
}


model Staff {
  id        String   @id @default(cuid())
  salonId   String
  name      String
  phone     String?
  role      String?  // e.g. barber, stylist
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  schedules    StaffSchedule[]
  exceptions   StaffException[]

  @@index([salonId]) 
   @@unique([salonId, name], name: "salonId_name")
}


model StaffSchedule {
  id        String   @id @default(cuid())
  staffId   String
  // 0=Sunday .. 6=Saturday
  dayOfWeek Int
  // store as minutes since midnight to avoid timezone edge cases
  startMin Int @default(0)
  endMin Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek]) 
  @@unique([staffId, dayOfWeek], name: "staffId_dayOfWeek")
}


model StaffException {
  id        String   @id @default(cuid())
  staffId   String
  date      DateTime // date (00:00) in salon timezone
  isOff     Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model Customer {
  id        String   @id @default(cuid())
  salonId   String
  name      String
  phone     String
  email     String?
  notes     String?
  consent   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  waitlist     WaitlistEntry[]

  @@index([salonId])
  @@index([salonId, phone])
}

model Appointment {
  id        String            @id @default(cuid())
  salonId   String
  serviceId String
  staffId   String
  customerId String

  startAt   DateTime
  endAt     DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  cancellation Cancellation?
  payments     Payment[]

  @@index([salonId, startAt])
  @@index([staffId, startAt])
}

model Cancellation {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  reason        String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  salonId    String
  customerId String
  serviceId  String?
  // preferred time window in minutes since midnight (optional)
  fromMin    Int?
  toMin      Int?
  note       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id])

  @@index([salonId, isActive])
  @@index([customerId])
}

model Payment {
  id                  String          @id @default(cuid())
  salonId             String
  appointmentId       String?
  provider            PaymentProvider @default(STRIPE)
  status              PaymentStatus   @default(PENDING)
  amountCents         Int
  currency            String          @default("EUR")
  description         String?
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  providerPaymentId   String?
  providerCheckoutUrl String?
  paidAt              DateTime?
  expiresAt           DateTime?
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt])
  @@index([appointmentId])
  @@index([provider, providerPaymentId])
  @@index([status, createdAt])
}

model MessageLog {
  id        String         @id @default(cuid())
  salonId   String
  channel   MessageChannel
  to        String
  template  String
  status    MessageStatus  @default(QUEUED)
  provider  String?
  payload   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, createdAt])
}

model WebhookClient {
  id        String   @id @default(cuid())
  salonId   String
  name      String
  // store a hashed secret if you want; MVP uses plain secret env.
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, isActive])
}
